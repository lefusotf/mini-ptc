<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!--
      Cambie "Server" por el nombre de su instancia de SQL Server, por ejemplo:
        localhost   |   .\SQLEXPRESS   |   DESKTOP-ABC123\SQLEXPRESS
      Con autenticación de SQL Server use:
        Server=localhost;Database=ClinicaMedicaDB;User Id=sa;Password=*****;TrustServerCertificate=True;
    -->
    <add name="ClinicaDB"
         connectionString="Server=localhost;Database=ClinicaMedicaDB;Integrated Security=True;TrustServerCertificate=True;Connect Timeout=10;"
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
</configuration>
